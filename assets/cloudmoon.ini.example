# Private CloudMoon active-session data imported from the phone helper.
# Keep this file private. android_instance_id identifies an active session.
game=PACKAGE_NAME
user_id=CLOUDMOON_USER_ID
android_instance_id=BASE64_ANDROID_INSTANCE_ID

# Alternative: paste a full HTTPS CloudMoon game-session URL here.
# When non-empty, the client extracts game/user_id/android_instance_id from it.
session_url=
