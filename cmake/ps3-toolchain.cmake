set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR powerpc)
set(PS3DEV "$ENV{PS3DEV}" CACHE PATH "PS3DEV toolchain root")
if(NOT PS3DEV)
  message(FATAL_ERROR "PS3DEV must point to the PSL1GHT SDK")
endif()
set(CMAKE_C_COMPILER "${PS3DEV}/ppu/bin/ppu-gcc")
set(CMAKE_CXX_COMPILER "${PS3DEV}/ppu/bin/ppu-g++")
set(CMAKE_AR "${PS3DEV}/ppu/bin/ppu-ar")
set(CMAKE_RANLIB "${PS3DEV}/ppu/bin/ppu-ranlib")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(THREADS_PREFER_PTHREAD_FLAG FALSE CACHE BOOL "" FORCE)
set(CMAKE_HAVE_LIBC_PTHREAD TRUE CACHE BOOL "" FORCE)
set(CMAKE_USE_PTHREADS_INIT 1 CACHE BOOL "" FORCE)
set(CMAKE_C_FLAGS_INIT "-mcpu=cell -mstrict-align -O2 -I${CMAKE_CURRENT_LIST_DIR}/ps3/include -D__Userspace__ -DNO_IFADDRS -DNO_PMTUDISC -I${PS3DEV}/ppu/include -I${PS3DEV}/portlibs/ppu/include -include ${CMAKE_CURRENT_LIST_DIR}/../src/cloudmoon_clock_compat.h")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cell -mstrict-align -O2 -std=gnu++17 -D__Userspace__ -I${CMAKE_CURRENT_LIST_DIR}/../build/ps3deps/include -I${CMAKE_CURRENT_LIST_DIR}/ps3/include -I${PS3DEV}/ppu/include -I${PS3DEV}/portlibs/ppu/include -include ${CMAKE_CURRENT_LIST_DIR}/../src/cloudmoon_clock_compat.h")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-mcpu=cell -mstrict-align -L${PS3DEV}/ppu/lib -L${PS3DEV}/portlibs/ppu/lib -lpthread")
set(CMAKE_FIND_ROOT_PATH "${PS3DEV}/ppu" "${PS3DEV}/portlibs/ppu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
